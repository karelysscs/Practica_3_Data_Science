# Copia este archivo como ".env" (sin ".example") y completa tus valores reales.
# ".env" NUNCA se sube a git (ver .gitignore).

# --- OpenAI (LLM del motor RAG + embeddings text-embedding-3-small, Fase 4) ---
OPENAI_API_KEY=

# Modelo de chat usado para generar respuestas del RAG
OPENAI_CHAT_MODEL=gpt-4o-mini

# Modelo de embeddings de OpenAI usado en la comparación de la Fase 4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Gemini (alternativa gratuita para el LLM del motor RAG) ---
# Requiere OPENAI_API_KEY para embeddings/Fase 4 igual; esto solo sustituye
# el modelo de chat que responde preguntas si config.yaml: rag_engine.llm_provider = "gemini"
# Consigue una key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
